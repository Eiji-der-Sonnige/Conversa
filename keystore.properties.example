# Vorlage: Diese Datei nach "keystore.properties" kopieren und ausfüllen.
# keystore.properties wird NICHT auf GitHub hochgeladen (.gitignore).
#
# Wichtig: In .properties-Dateien ist "\" ein Sonderzeichen.
# Pfade daher mit "/" schreiben, z. B. C:/Users/Name/Keystores/conversa-release.jks
storeFile=C:/Users/DEIN_NAME/Keystores/conversa-release.jks
storePassword=HIER_KEYSTORE_PASSWORT
keyAlias=conversa
keyPassword=HIER_SCHLUESSEL_PASSWORT
